<resources>
    <style name="Theme.Snoozy" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/coral</item>
        <item name="android:textViewStyle">@style/SnoozyText</item>
    </style>

    <style name="SnoozyText" parent="@android:style/Widget.Material.TextView">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="SnoozyChip" parent="SnoozyText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
