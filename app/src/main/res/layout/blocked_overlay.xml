<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated by the service, which has no theme, so fonts/colors are set here. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:contentDescription="@null"
            android:src="@drawable/snoozy_face" />

        <TextView
            android:id="@+id/blockedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:textColor="@color/cream"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/overlay_description"
            android:textColor="@color/ink_soft"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Top margin is set in code to clear the status bar. -->
    <TextView
        android:id="@+id/coverBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_back_night"
        android:clickable="true"
        android:contentDescription="Back"
        android:focusable="true"
        android:fontFamily="@font/nunito"
        android:gravity="center"
        android:text="‹"
        android:textColor="@color/cream"
        android:textSize="30sp"
        android:textStyle="bold" />
</FrameLayout>
