<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated by the service, which has no theme, so fonts/colors are set here.
     The dimmed backdrop swallows touches until OK is pressed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:clickable="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@null"
            android:src="@drawable/snoozy_face" />

        <TextView
            android:id="@+id/snoozeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/snooze_modal_message"
            android:textColor="@color/ink_soft"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/snoozeOk"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:text="OK"
            android:textColor="@color/card"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
