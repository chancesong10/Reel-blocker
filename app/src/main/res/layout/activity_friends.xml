<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="28dp">

        <include layout="@layout/view_page_header" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.2"
            android:text="When someone sends you a Reel in DMs, you can watch that one Reel. Swiping to more stays blocked. People show up here after you open a chat with them."
            android:textColor="@color/ink_soft"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/allowAll"
                style="@style/SnoozyChip"
                android:text="Allow all" />

            <TextView
                android:id="@+id/blockAll"
                style="@style/SnoozyChip"
                android:text="Block all" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/friendsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:id="@+id/friendsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/friendsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="24dp"
                android:text="No chats yet. Open a DM in Instagram and it'll show up here."
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
